# Copy to .env and fill in. Never commit .env.

# --- Shared by bot and web panel -------------------------------------------
# Long random text; signs the panel's session cookies.
SECRET_KEY=
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# --- Bot only ---------------------------------------------------------------
BOT_TOKEN=
# EVE Online SSO application
CLIENT_ID=
CLIENT_SECRET=
ESI_USER_CONTACT_EMAIL=
# True writes debug output to the log.
TESTMODE=

# --- Web panel only ---------------------------------------------------------
# OAuth2 client of the Discord application (Developer Portal > OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Where browsers reach the panel. Register <WEB_BASE_URL>/callback as redirect
# in the Developer Portal.
WEB_BASE_URL=https://panel.example.com
# Further host names the panel answers to, comma separated (optional).
WEB_ALLOWED_HOSTS=
# 1 only for local development: allows cookies without HTTPS and shows error details.
WEB_DEBUG=0

# --- docker compose (optional) ----------------------------------------------
PANEL_BIND=127.0.0.1
PANEL_PORT=8000
